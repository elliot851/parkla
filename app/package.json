{
  "name": "parkla-app",
  "version": "1.0.0",
  "private": true,
  "description": "Parkla nativ wrapper (Capacitor) for App Store + Google Play + Huawei AppGallery",
  "scripts": {
    "build": "rm -rf www && cp -r ../site www && node -e \"console.log('www klar')\"",
    "sync": "npm run build && cap sync",
    "assets": "capacitor-assets generate --iconBackgroundColor '#F5F7F6' --splashBackgroundColor '#F5F7F6'",
    "open:ios": "cap open ios",
    "open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/status-bar": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/geolocation": "^6.1.0",
    "@capacitor/push-notifications": "^6.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@capacitor/assets": "^3.0.5"
  }
}
